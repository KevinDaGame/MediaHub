@using System.Web
@using MediaHub.DAL.Model
@using MediaHub.DAL.Services
@using MediaHub.API.Components.Dropdown
@using MediaHub.API.Models
@using MediaHub.API.Services
@using System.Security.Claims

@rendermode InteractiveServer

@page "/media"
@page "/"

@inject IMediaService MediaService
@inject MediaWithWatchStatusService MediaWithWatchStatusService
@inject NavigationManager Navigator
@inject IJSRuntime JSRuntime
@inject AuthenticationStateProvider AuthenticationStateProvider

<MediaBreadCrumb id="@Id" ChangePathCallBack="ChangePathCallBack"/>
<div class="flex flex-wrap gap-5 m-5">
    @foreach (var item in _mediaList)
    {
        <div
            class="group text-white p-2 border-2 border-emerald-400 hover:border-rose-400 transition-colors rounded-2xl bg-gray-900 w-64 flex flex-col gap-2 relative" accesskey
            @onclick="() => HandleItemClick(item)">
            @if (item.Type == MediaType.FILE)
            {
                <div class="absolute top-3 right-3 z-10">
                    <Dropdown>
                        <DropdownItem OnClick="@(() => CopyLink(item))">Copy link</DropdownItem>
                    </Dropdown>
                </div>
                
                @if (item.IsWatched)
                {
                    <div class="absolute top-3 left-3 bg-green-600 text-white px-2 py-1 rounded-md z-10">
                        <i class="fa-solid fa-check"></i> Watched
                    </div>
                }
            }
            <img class="" src="@GetThumbnailUrl(item)" width="600" height="300" alt="Card image cap">
            <h5 class="text-xl">@item.Name</h5>
        </div>
    }
</div>
<script>
  window.triggerFileDownload = (fileName, url) => {
    const anchorElement = document.createElement('a');
    anchorElement.href = url;
    anchorElement.download = fileName ?? '';
    anchorElement.click();
    anchorElement.remove();
  }
</script>

@code {
    private IEnumerable<MediaWithWatchStatusViewModel> _mediaList = [];

    [SupplyParameterFromQuery(Name = "id")]
    private Guid? Id { get; set; }

    public EventCallback<Guid?> ChangePathCallBack { get; set; }

    protected override void OnInitialized()
    {
        ChangePathCallBack = EventCallback.Factory.Create<Guid?>(this, ChangeMediaId);
    }

    private void ChangeMediaId(Guid? newId)
    {
        if(newId == null)
        {
         Navigator.NavigateTo("media");
        }
        Navigator.NavigateTo("media?id=" + newId);
    }

    protected override async Task OnParametersSetAsync()
    {
        await GetMediaAsync();
    }

    private async Task GetMediaAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        
        _mediaList = MediaWithWatchStatusService.GetMediaWithWatchStatus(Id, user);
    }

    public string GetThumbnailUrl(MediaWithWatchStatusViewModel media)
    {
        return media.ThumbnailPath != null ? Navigator.BaseUri + "api/media/thumbnail?id=" + media.Id : "movie.png";
    }

    private async Task HandleItemClick(MediaWithWatchStatusViewModel item)
    {
        switch (item.Type)
        {
            case MediaType.DIRECTORY:
                ChangeMediaId(item.Id);
                await GetMediaAsync();
                break;
            case MediaType.FILE:
                // Navigator.NavigateTo("api/media/file?id=" + item.Id);
                //download file without navigating
                var fileUrl = Navigator.BaseUri + "api/media/file?id=" + item.Id;
                var fileName = item.Name;
                await JSRuntime.InvokeVoidAsync("triggerFileDownload", fileName, fileUrl);
                
                // Refresh the media list after download to update the watched status
                await Task.Delay(1000); // Small delay to ensure the watched status is updated
                await GetMediaAsync();
                break;
            default:
                throw new ArgumentOutOfRangeException();
        }
    }

    private void CopyLink(MediaWithWatchStatusViewModel item)
    {
        JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", Navigator.BaseUri + "api/media/file?id=" + item.Id);
    }
}